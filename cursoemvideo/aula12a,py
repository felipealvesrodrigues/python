nome = str(input('Qual é o seu nome? ')).lower()
if nome == 'felipe':
    print('Belo nome!!')
elif nome == 'pedro' or nome == 'maria' or nome == 'paulo':
    print('Seu nome é bastante popular no Brasil.')
else:
    print('Que nome normal.')       
print('Tenha um bom dia, {}!'.format(nome.capitalize()))